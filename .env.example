# NearBuy Unified Platform — Environment Configuration Example
# Copy to .env (never commit real secrets).

# Runtime environment: 'development' or 'production'
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Authoritative SQLite database path (on a persistent volume in production)
NEARBUY_DB_FILE=./data/seller-hub.sqlite

# 32-byte encryption key for sensitive records (PAN, payout account numbers).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEARBUY_DATA_KEY=

# Optional Demo Data Seeding (set SEED_DEMO=0 in production so no demo accounts are created)
SEED_DEMO=0

# Optional CLI Operations API key (Control Tower UI uses authenticated admin sessions)
OPS_API_KEY=

# Session cookie settings (set SESSION_SAMESITE=lax on same-origin HTTPS production)
SESSION_SAMESITE=lax

# Delivery network tuning
DELIVERY_OFFER_SECONDS=45
DELIVERY_GEOFENCE_M=250
DELIVERY_LOCATION_FRESH_SECONDS=300
DELIVERY_CODE_TTL_HOURS=24

# External Email Provider (SMTP) — required for real verification/reset email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=NearBuy <no-reply@nearbuy.example>

# External Integrations NOT yet configured (require real vendor credentials before claiming live support):
# - Payment Gateway (Razorpay / Cashfree / Stripe): online prepaid payments remain 'unconfirmed_prepaid' until integrated
# - SMS OTP Provider (MSG91 / Twilio / AWS SNS): partner mobile OTPs are logged in dev/test mode only
# - KYC / Document Verification API (Surepass / Karza / DigiLocker): admin manual verification is active
# - Geocoding / Routing API (MapmyIndia / Google Maps / OpenRouteService): zone PIN centroids + haversine road factor active
